# Copiare in .env e completare prima di avviare lo stack.

# --- Database ---------------------------------------------------------------
POSTGRES_USER=tempra
POSTGRES_DB=tempra
# Generare con: openssl rand -hex 24
# Esadecimale e non base64: i caratteri / + $ finirebbero dentro DATABASE_URL
# e dentro l'interpolazione di docker compose, rompendo entrambi.
POSTGRES_PASSWORD=

# --- API --------------------------------------------------------------------
# Generare con: openssl rand -hex 48
JWT_SECRET=
# Origini da cui la PWA puo' chiamare l'API, separate da virgola.
ALLOWED_ORIGINS=http://localhost:8080
# Mettere a false su una istanza personale, dopo aver creato il proprio account.
REGISTRATION_OPEN=true

# --- PWA --------------------------------------------------------------------
# Indirizzo pubblico dell'API. Lasciare vuoto per usare Tempra senza
# sincronizzazione: in quel caso i dati restano solo sul dispositivo.
VITE_API_URL=

# --- Porte pubblicate localmente --------------------------------------------
WEB_PORT=8080
API_PORT=3000
